# .env.example — placeholder values ONLY. Never commit a real .env.
# Copy to .env and fill in real values; .env is gitignored.

# "fixture" (default, offline demo) or "live" (real Qloo calls)
APP_MODE=fixture

# Real key goes here in your local .env; never in source, fixtures, or logs
QLOO_API_KEY=placeholder-not-a-real-key

# Hackathon base URL (the ONLY URL the hackathon key works against).
# Staging/production always 401 with a hackathon key (docs/qloo-api-notes.md §2).
QLOO_BASE_URL=https://hackathon.api.qloo.com

# SQLite locally; Neon Postgres later (DATABASE_URL from your .env, never quoted in chat)
DATABASE_URL=sqlite:///./consentiens_culturae.db

# Optional tuning (defaults shown)
QLOO_TIMEOUT_SECONDS=10
QLOO_MAX_CALLS_PER_RUN=10
INSUFFICIENT_COVERAGE_THRESHOLD=0.5

# G3 agent roles: flag-gated, deterministic fallback is the default (off).
# Real key goes in local .env only; never in source, fixtures, or logs.
# LLM_BASE_URL accepts any OpenAI-compatible endpoint. Default is OpenAI.
# For the OpenRouter free tier, set:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
# ...and LLM_MODEL to an OpenRouter model id (they are NOT OpenAI model ids).
# Google AI Studio's OpenAI-compatible endpoint is supported: set
#   LLM_PROVIDER=google  → default base URL generativelanguage.googleapis.com
#   and put the AI Studio key in GEMINI_API_KEY (local .env only).
# The researcher may ride a different pool than analyst/critic:
#   LLM_RESEARCHER_MODEL / LLM_RESEARCHER_BASE_URL (e.g. keep the researcher on
#   OpenRouter while main moves to Google), optional dedicated key via
#   LLM_RESEARCHER_API_KEY_ENV (name of the env var holding that key).
LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=placeholder-not-a-real-key
GEMINI_API_KEY=placeholder-not-a-real-key
LLM_RESEARCHER_MODEL=
LLM_RESEARCHER_BASE_URL=
LLM_RESEARCHER_API_KEY_ENV=

# Attribute suggester (2026-10-23): the cheap assist model for the pre-run
# attribute proposals. No dedicated key (rides the main pool's); unset model
# or base URL falls back to LLM_MODEL / LLM_BASE_URL.
LLM_SUGGESTER_MODEL=
LLM_SUGGESTER_BASE_URL=

# API run limiter (protects the free-model LLM pool; 2026-10-20).
# One run at a time, minimum seconds between run starts, cap per UTC day.
# 0 on either value disables that cap (the single-flight guard stays on).
RUN_MIN_GAP_SECONDS=30
RUNS_PER_DAY=50
